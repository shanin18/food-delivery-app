{
  "expo": {
    "name": "Food Delivery",
    "slug": "food-delivery",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "fooddelivery",
    "userInterfaceStyle": "automatic",
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-secure-store",
      ["expo-location", { "locationWhenInUsePermission": "Allow Food Delivery to use your location to set your delivery address." }]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
